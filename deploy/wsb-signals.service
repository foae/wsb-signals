[Unit]
Description=WSB Signals — near-live r/wallstreetbets trending radar (poll -> H_e -> market overlay)
Documentation=file://__WSB_DIR__/README.md
# network-online.target may not exist in the user manager; harmless if absent. The run loop also
# self-heals through transient network failure (per-cycle guard), so this ordering is best-effort.
After=network-online.target
Wants=network-online.target
# Crash-loop backstop: at most 5 starts per 5 min, then systemd stops trying (inspect with status).
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=__WSB_DIR__
# The venv entry point — deterministic, offline, no PATH/uv dependency at runtime.
# Requires `uv sync` to have built .venv first (and after any dependency change).
ExecStart=__WSB_DIR__/.venv/bin/wsb run
Restart=always
RestartSec=30
# SIGTERM is handled gracefully (closes source/market/DB) — give it time before SIGKILL.
TimeoutStopSec=30
SyslogIdentifier=wsb-signals

[Install]
WantedBy=default.target
