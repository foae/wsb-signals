# WSB Signals v2 runtime configuration. Copy this file to deploy/v2/.env and replace placeholders.
#
#   cp deploy/v2/.env.example deploy/v2/.env
#
# .env is ignored by git. Keep credentials only in that private file or an equivalent runtime
# environment injector; do not put them in compose.yml or image build arguments.

# ── Database ─────────────────────────────────────────────────────────────────
# Compose bridge networking resolves the database service as `db`.
# If a password contains URL-reserved characters, percent-encode it in both connection URLs.
DATABASE_URL=postgres://wsb:change-this-password@db:5432/wsb_signals
POSTGRES_USER=wsb
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=wsb_signals

# ── Worker integrations ──────────────────────────────────────────────────────
# Optional market-data credentials. Leaving either blank keeps the worker in its documented
# empirical-only/cashtag-only degraded mode.
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Optional endpoint overrides; omit to use the application's defaults.
# ALPACA_ENDPOINT_URL=
# ALPACA_DATA_URL=

# ── Plays LLM ────────────────────────────────────────────────────────────────
# The base Compose file clears CODEX_AUTH_FILE and has no OAuth file mount, so leave OAuth
# configuration absent for capture/media-only operation.
#
# This platform API key is injected only when the application configuration is deliberately changed
# to select the `openai` provider. Setting this key alone does not change the current provider.
# Before making that application change, verify the selected models and non-zero pricing entries so
# the existing fail-closed dispatch guard remains effective.
OPENAI_API_KEY=

# ── Web read-only database role ──────────────────────────────────────────────
# The worker provisions this role on boot. The web must use exactly these credentials and never the
# writer URL above.
WEB_RO_USER=wsb_web
WEB_RO_PASSWORD=change-this-readonly-password
NUXT_DATABASE_URL=postgres://wsb_web:change-this-readonly-password@db:5432/wsb_signals
