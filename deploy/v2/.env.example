# WSB Signals v2 — required secrets and config. Copy to .env and fill in real values.
#
#   cp deploy/v2/.env.example deploy/v2/.env
#
# Nothing in this file is baked into the image. All secrets are injected at runtime via env_file.

# ── Database ─────────────────────────────────────────────────────────────────────────────────────

# Full Postgres connection URL consumed by the worker (writer role).
#
# HOST NETWORKING (this Incus/LXC host — the default for this repo's compose):
#   Postgres binds to localhost:5432, so the worker reaches it at localhost — use:
DATABASE_URL=postgres://wsb:changeme@localhost:5432/wsb_signals
#
# NORMAL BRIDGE NETWORKING (standard Docker host — see compose.yml networking comment):
#   Replace localhost with the Postgres service name and drop network_mode: host from compose.yml:
# DATABASE_URL=postgres://wsb:changeme@db:5432/wsb_signals

# These three must match the values in DATABASE_URL above; they configure the db service container.
POSTGRES_USER=wsb
POSTGRES_PASSWORD=changeme
POSTGRES_DB=wsb_signals

# ── Alpaca — market overlay + whitelist builder ───────────────────────────────────────────────────

# API credentials (paper or live). Without these the worker runs empirical-only (H_e only, no H_m
# overlay) AND the whitelist builder cannot fetch the Alpaca asset universe, so the extractor falls
# back to cashtag-only mode (no bare-token matching). The radar still runs — just degraded.
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_API_SECRET=your_alpaca_api_secret_here

# Optional: override Alpaca endpoints (defaults shown below).
# ALPACA_ENDPOINT_URL is used by build-whitelist (asset universe fetch).
# ALPACA_DATA_URL is used by the market client (bars, snapshots, screeners).
# ALPACA_ENDPOINT_URL=https://paper-api.alpaca.markets/v2
# ALPACA_DATA_URL=https://data.alpaca.markets
