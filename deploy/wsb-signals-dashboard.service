[Unit]
Description=WSB Signals — Streamlit dashboard (reads the JSON snapshot; no DuckDB lock)
Documentation=file://__WSB_DIR__/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__WSB_DIR__
# Binds to dashboard.address:port from config.toml (default 0.0.0.0:8501). Spawns Streamlit in
# this control group; on stop systemd reaps the child too (KillMode=control-group default).
ExecStart=__WSB_DIR__/.venv/bin/wsb dashboard
Restart=always
RestartSec=10
TimeoutStopSec=20
SyslogIdentifier=wsb-signals-dashboard

[Install]
WantedBy=default.target
