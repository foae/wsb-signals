[Unit]
Description=Run the WSB Signals freshness heartbeat every 10 minutes
Documentation=file://__WSB_DIR__/README.md

[Timer]
OnBootSec=2min
OnUnitActiveSec=10min
# The run loop already logs freshness each cycle; this timer is an independent watchdog that flips
# the unit to `failed` (and journals an error) when Arctic-Shift goes stale — see the README runbook.
Unit=wsb-signals-heartbeat.service

[Install]
WantedBy=timers.target
