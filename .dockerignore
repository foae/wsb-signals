# Keep the build context small and never bake secrets / local state into the image.
.git/
.gitignore

# Local Python env + caches (the image builds its own venv via uv)
.venv/
venv/
__pycache__/
**/__pycache__/
*.pyc
*.egg-info/

# Secrets — creds reach the container via compose env_file, never the image
.env
.env.*

# Local data store (the running container uses the persisted named volume instead)
data/

# Derived ticker universe — rebuilt at container start (entrypoint), not baked
whitelist/symbols.txt

# Not needed at runtime
deploy/
scripts/
sources/
design/
tests/
*.md
.firecrawl/
