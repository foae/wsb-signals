# Secrets / local env — NEVER commit
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
build/
dist/

# Local data store (forward-collected; not for git)
*.duckdb
*.sqlite
data/

# Derived ticker whitelist — refreshable via `wsb build-whitelist` (stoplist.txt is curated, kept)
whitelist/symbols.txt

# Node / TypeScript (v2 monorepo)
node_modules/
.pnpm-store/
*.tsbuildinfo
packages/*/dist/
packages/*/.nuxt/
packages/*/.output/
packages/*/.nitro/
fixtures/*.json
