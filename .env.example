# Alpaca API — WSB Signals market-data funnel. See sources/alpaca.md.
# Copy to .env and fill in. .env is gitignored — NEVER commit real keys.
# Credentials are sent as HTTP headers: APCA-API-KEY-ID / APCA-API-SECRET-KEY.

ALPACA_ENDPOINT_URL="https://paper-api.alpaca.markets/v2"   # trading API (paper)
ALPACA_DATA_URL="https://data.alpaca.markets"               # market data API
ALPACA_API_KEY=""                                            # APCA-API-KEY-ID
ALPACA_API_SECRET=""                                         # APCA-API-SECRET-KEY (sensitive)
