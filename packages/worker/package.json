{
  "name": "@wsb/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "WSB Signals v2 worker — the TS radar (ingest → extract → classify → H_e → H_m → publish). Standalone Node process; single Postgres writer. See design/v2-plan.md §1.",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:it": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@wsb/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "undici": "^8.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.1",
    "@types/node": "^24.13.0",
    "@types/pg": "^8.20.0",
    "fast-check": "^4.8.0",
    "pino-pretty": "^13.1.3",
    "testcontainers": "^12.0.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
