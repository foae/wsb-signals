{
  "name": "@wsb/worker",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "WSB Signals v2 worker - the TS radar (ingest -> extract -> classify -> H_e -> H_m -> publish). Standalone Node process; single Postgres writer. See design/v2-plan.md §1.",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build-whitelist": "tsx src/build-whitelist.ts",
    "heartbeat": "tsx src/heartbeat.ts",
    "plays-eval": "tsx src/plays/eval.ts",
    "analyze": "tsx src/analysis/cli.ts",
    "heat-extract-eval": "tsx src/heat-extract-eval.ts",
    "heat-calibrate": "tsx src/heat-calibrate.ts",
    "plays-export": "tsx src/analysis/plays-export.ts",
    "codex-login": "tsx src/plays/codex-login.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:it": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.58",
    "@wsb/shared": "workspace:*",
    "ai": "^7.0.92",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "sharp": "^0.35.4",
    "smol-toml": "^1.8.0",
    "undici": "^8.10.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "fast-check": "^4.9.0",
    "pino-pretty": "^13.1.3",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
