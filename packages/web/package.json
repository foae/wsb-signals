    "@nuxtjs/html-validator": "^2.1.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.21.0",
    "eslint": "^10.8.1",
    "typescript": "^6.0.3",
